{
  "name": "@inversealtruism/csd-light",
  "version": "0.1.28",
  "engines": {
    "node": ">=22"
  },
  "description": "Compute Substrate light client: headers-first sync with client-side PoW, LWMA and chainwork verification, merkle-inclusion proofs, reorg and checkpoint start; its inclusion and balance reads carry a trustLevel.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx test/light-offline.test.ts && tsx test/records.test.ts && tsx test/content-bind.test.ts && tsx test/bind-canonical.test.ts && tsx test/lwma-memo.test.ts && tsx test/route.test.ts && tsx test/route-consumers.test.ts",
    "test:live": "tsx test/light.test.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@inversealtruism/csd-codec": "workspace:*",
    "@inversealtruism/csd-client": "workspace:*"
  },
  "devDependencies": {
    "@inversealtruism/csd-vectors": "workspace:*"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InverseAltruism/csd-sdk.git",
    "directory": "packages/light"
  },
  "homepage": "https://cairn-substrate.com"
}
