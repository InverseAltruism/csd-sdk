{
  "name": "@inversealtruism/cairnx-api",
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "description": "Pre-1.0 types, parameter parser, cursor codec and pure handlers of the CairnX read API, version 1, for the CairnX resolver to mount; the contract can change in any release before 1.0.0. No I/O; browser-safe.",
  "author": "InverseAltruism",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./handlers": {
      "import": {
        "types": "./dist/handlers/index.d.ts",
        "default": "./dist/handlers/index.js"
      },
      "require": {
        "types": "./dist/handlers/index.d.cts",
        "default": "./dist/handlers/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/handlers/index.ts --format esm,cjs --dts --clean",
    "test": "tsx test/params.test.ts && tsx test/cursor.test.ts && tsx test/errors.test.ts && tsx test/rows.test.ts && tsx test/handlers.test.ts && tsx test/walk.test.ts && tsx test/feed.test.ts && tsx test/package.test.ts && tsx test/bundle.test.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "peerDependencies": {
    "@inversealtruism/cairnx-core": "workspace:*"
  },
  "devDependencies": {
    "@inversealtruism/cairnx-core": "workspace:*"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InverseAltruism/csd-sdk.git",
    "directory": "packages/cairnx-api"
  },
  "homepage": "https://cairn-substrate.com"
}
