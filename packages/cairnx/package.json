{
  "name": "@inversealtruism/cairnx-core",
  "version": "0.2.2",
  "engines": {
    "node": ">=18"
  },
  "description": "CairnX: tokens, atomic DvP trades and leased .csd names on Compute Substrate, as a pure deterministic convention library (Ordinals/Runes class). Ships the normative CONVENTION.md and the conformance vectors.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mm": {
      "import": {
        "types": "./dist/mm/index.d.ts",
        "default": "./dist/mm/index.js"
      },
      "require": {
        "types": "./dist/mm/index.d.cts",
        "default": "./dist/mm/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONVENTION.md",
    "MAKERS.md",
    "test/vectors"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/mm/index.ts --format esm,cjs --dts --out-dir dist/mm",
    "test": "node test/run.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@inversealtruism/csd-codec": "workspace:*"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InverseAltruism/csd-sdk.git",
    "directory": "packages/cairnx"
  },
  "homepage": "https://cairn-substrate.com/trade"
}
